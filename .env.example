# Copy to .env and fill in. Real environment variables override this file.
# All settings are defined in llm_engineering/settings/app_settings.py.

# ---- MongoDB (raw data store) -------------------------------------------
# Either give the parts (a connection string is built for you) ...
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=digital_twin
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# MONGO_SCHEME=mongodb+srv            # for MongoDB Atlas (port is then ignored)
# MONGO_OPTIONS={"retryWrites": "true"}
# ... or override everything with one URI:
# MONGO_URI=mongodb://user:pass@localhost:27017/digital_twin?authSource=admin

# ---- GitHub (optional token: 5000 req/hour instead of 60; private repos) --
GITHUB_TOKEN=

# ---- DVC versioning of data/raw ------------------------------------------
DVC_ENABLED=true
DVC_AUTO_COMMIT=true
DVC_AUTO_PUSH=true
# DVC_REMOTE=local

# ---- Raw data store backend ----------------------------------------------
RAW_STORE_BACKEND=mongo
